#!/usr/bin/env python3
"""Hermes isolated delivery publisher.

Never executes candidate code. Reads verified receipts produced by supervisor,
inspects SHA and required checks, and opens PR or merges via GitHub App identity.
"""
import argparse
import json
from pathlib import Path
import sys


def main():
    parser = argparse.ArgumentParser(description="Hermes PR Publisher")
    parser.add_argument("--receipt", required=True, type=Path, help="Path to verified pass.json receipt")
    args = parser.parse_args()

    if not args.receipt.exists():
        print(f"Error: Receipt {args.receipt} not found", file=sys.stderr)
        return 3

    receipt = json.loads(args.receipt.read_text())
    if receipt.get("result") != "PASS":
        print(f"Error: Receipt status is {receipt.get('result')}, refusing to publish.", file=sys.stderr)
        return 1

    print(f"Receipt for commit {receipt.get('commit')} verified. Publishing eligible.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
