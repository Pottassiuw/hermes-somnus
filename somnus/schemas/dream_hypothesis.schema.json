{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-somnus/schemas/dream_hypothesis.schema.json",
  "title": "DreamHypothesis",
  "description": "A falsifiable proposal generated during the ideation phase. A hypothesis without a fixture that fails on today's baseline cannot prove anything tomorrow and is rejected before any build tokens are spent.",
  "type": "object",
  "required": ["id", "created_at", "source", "intent", "hypothesis", "target", "test_scenario", "success_metrics", "risk"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^dh_[0-9a-f]{12}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["queued", "building", "benched", "accepted", "rejected", "aborted"] },

    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["open_failure", "counterfactual_repair", "repetition_pattern",
                   "cross_domain", "efficiency_delta", "contract_drift", "freeform"],
          "description": "Ordered by measured expected value. `freeform` is capped at ~1 per night."
        },
        "failure_ids": { "type": "array", "items": { "type": "string" } },
        "regions": {
          "type": "array", "items": { "type": "string" }, "maxItems": 2,
          "description": "cross_domain only: exactly two memory regions."
        },
        "distance": {
          "type": "number",
          "description": "Embedding distance between regions. Must exceed memory.min_pair_distance — similarity-sampled pairs reproduce the measured within-domain null (arXiv:2607.16256)."
        }
      }
    },

    "intent": { "type": "string", "maxLength": 280 },
    "hypothesis": {
      "type": "string", "maxLength": 1000,
      "description": "IF <change> THEN <metric> improves BECAUSE <mechanism>."
    },

    "target": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["skill", "skill_patch", "prompt_section", "tool_description",
                           "memory_region", "script", "config"] },
        "path": { "type": "string" }
      }
    },

    "test_scenario": {
      "type": "object",
      "required": ["fixture_ids", "baseline_must_fail"],
      "properties": {
        "fixture_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "baseline_must_fail": {
          "const": true,
          "description": "The falsifiability gate. Asserted by actually running the fixture against the current baseline before building."
        },
        "repeats": { "type": "integer", "minimum": 3, "default": 3 },
        "isomorphic_variants": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },

    "success_metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "direction", "min_effect"],
        "properties": {
          "name": { "enum": ["pass_rate", "tokens", "latency_ms", "tool_calls",
                             "turns", "error_rate", "retrieval_precision"] },
          "direction": { "enum": ["increase", "decrease"] },
          "min_effect": { "type": "number", "description": "Pre-registered MDE." },
          "alpha": { "type": "number", "default": 0.01 }
        }
      }
    },

    "budget": {
      "type": "object",
      "properties": {
        "max_llm_calls": { "type": "integer", "default": 40 },
        "max_wall_s": { "type": "integer", "default": 900 },
        "max_usd": { "type": "number", "default": 1.0 }
      }
    },

    "risk": {
      "type": "object",
      "required": ["level", "write_set", "network"],
      "properties": {
        "level": { "enum": ["low", "medium", "high"] },
        "write_set": {
          "type": "array", "items": { "type": "string" },
          "description": "Allowlist. A diff touching anything outside this list is a hard reject — enumerate what is allowed, never what is forbidden."
        },
        "network": { "enum": ["none", "llm_only", "allowlist"] },
        "requires_human_before_build": { "type": "boolean", "default": false }
      }
    },

    "verdict": { "type": "object" }
  }
}
